# Required — copy to .env and set your EC2 public IP before docker compose up

VITE_USER_SERVICE_URL=http://YOUR_EC2_IP:8001
VITE_PORTFOLIO_SERVICE_URL=http://YOUR_EC2_IP:8002

# Agent API for the "Agent Chat" page. The agent runs locally (needs Ollama),
# so this points at your Mac, not EC2. Start it with: uvicorn server:app --port 8100
VITE_AGENT_URL=http://localhost:8100
