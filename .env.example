# Local (apira/docs/run-locally.md) — Vite bakes VITE_* at image build time.
VITE_USER_SERVICE_URL=http://localhost:8001
VITE_PORTFOLIO_SERVICE_URL=http://localhost:8002
VITE_AGENT_URL=http://localhost:8100
VITE_LOG_SERVICE_URL=http://localhost:8300

# Browser structured logging (only VITE_-prefixed values are exposed by Vite).
VITE_LOG_LEVEL=INFO
VITE_ENVIRONMENT=development

# EC2 (replace YOUR_EC2_IP with the instance Public IPv4):
# VITE_USER_SERVICE_URL=http://YOUR_EC2_IP:8001
# VITE_PORTFOLIO_SERVICE_URL=http://YOUR_EC2_IP:8002
# VITE_AGENT_URL=http://YOUR_EC2_IP:8100
# VITE_LOG_SERVICE_URL=http://YOUR_EC2_IP:8300
